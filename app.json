{
  "expo": {
    "name": "손울림",
    "slug": "DAYEON",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sonullim.app",
      "adaptiveIcon": {
        "backgroundColor": "#FED73F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFDF7"
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "도움을 요청할 때와 보호자가 위치를 확인할 때, 그 순간의 위치를 보호자에게 보내요.",
          "locationAlwaysAndWhenInUsePermission": "앱이 꺼져 있을 때도 보호자가 위치를 확인하면 그 순간의 위치를 한 번 보내요.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "scheme": "sonullim",
    "backgroundColor": "#FFFDF7",
    "experiments": {
      "typedRoutes": true
    }
  }
}
